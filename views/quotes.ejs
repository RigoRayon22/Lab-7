<%- include("partials/header") %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>All Quotes</h1>
  <a href="/addQuote" class="btn btn-primary">Add Quote</a>
</div>

<div class="card card-shadow">
  <div class="card-body">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Quote</th>
          <th>Category</th>
          <th>Author</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% quotes.forEach(q => { %>
          <tr>
            <td><%= q.quote %></td>
            <td><%= q.category %></td>
            <td><%= q.firstName %> <%= q.lastName %></td>
            <td>
              <a href="/updateQuote?quoteId=<%= q.quoteId %>" class="btn btn-sm btn-warning">Edit</a>
              <a href="/deleteQuote?quoteId=<%= q.quoteId %>"
                 class="btn btn-sm btn-danger"
                 onclick="return confirm('Delete this quote?')">Delete</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include("partials/footer") %>