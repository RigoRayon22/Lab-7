<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quotes Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="/home">Quotes Admin</a>

    <% if (user) { %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/authors">Authors</a></li>
          <li class="nav-item"><a class="nav-link" href="/quotes">Quotes</a></li>
          <li class="nav-item"><a class="nav-link" href="/addAuthor">Add Author</a></li>
          <li class="nav-item"><a class="nav-link" href="/addQuote">Add Quote</a></li>
        </ul>
        <span class="navbar-text text-light me-3">Logged in as <%= user.username %></span>
        <a class="btn btn-outline-light btn-sm" href="/logout">Logout</a>
      </div>
    <% } %>
  </div>
</nav>

<div class="container container-box">